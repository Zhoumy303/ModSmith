{
  "schemaVersion": 1,
  "id": "{{ mod_id }}",
  "version": "{{ mod_version }}",
  "name": "{{ mod_name }}",
  "description": "{{ mod_description }}",
  "authors": [
    "{{ author }}"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/{{ mod_id }}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "{{ package_name }}.ExampleMod"
    ]
  },
  "depends": {
    "fabricloader": ">={{ fabric_loader_version }}",
    "minecraft": "~{{ minecraft_version }}",
    "java": ">=25",
    "fabric-api": "*"
  }
}